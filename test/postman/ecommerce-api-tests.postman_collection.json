		{
			"name": "Order - 完整下单链路",
			"item": [
				{
					"name": "创建订单 - 正向",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('返回200', () => pm.expect(res.code).to.eql(200));",
									"pm.test('包含订单号', () => pm.expect(res.data.orderNo).to.be.a('string'));",
									"pm.test('状态为PENDING', () => pm.expect(res.data.status).to.eql('PENDING'));",
									"pm.variables.set('orderId', res.data.id);",
									"pm.variables.set('orderNo', res.data.orderNo);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/orders",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"addressId\": 1,\n  \"items\": [{\n    \"productId\": 1,\n    \"quantity\": 1\n  }],\n  \"remark\": \"测试下单\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "订单支付",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('返回200', () => pm.expect(res.code).to.eql(200));",
									"pm.test('状态变为PAID', () => pm.expect(res.data.status).to.eql('PAID'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"url": "{{base_url}}/orders/{{orderId}}/status",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"action\": \"pay\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "订单发货 (需管理员)",
					"event": [
