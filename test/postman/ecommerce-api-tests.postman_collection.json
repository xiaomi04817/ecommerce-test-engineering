					"request": {
						"method": "PUT",
						"url": "{{base_url}}/orders/{{orderId}}/status",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"action\": \"ship\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
