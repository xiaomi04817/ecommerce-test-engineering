{
	"info": {
		"name": "电商系统 API 测试集合",
		"description": "电商测试工程项目 — 接口测试集合\n\n包含所有模块的正向和异常测试用例。\n使用前请设置环境变量: base_url, username, password",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "username",
			"value": "testuser1"
		},
		{
			"key": "password",
			"value": "Test@123456"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// 自动在需要认证的请求中添加 Bearer Token",
					"const token = pm.variables.get('token');",
					"if (token) {",
					"    pm.request.headers.add({",
					"        key: 'Authorization',",
					"        value: `Bearer ${token}`",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		},
		{
			"listen": "test",
			"script": {
				"exec": [
					"// 登录后自动提取 token",
					"const response = pm.response.json();",
					"if (response.code === 200 && response.data && response.data.token) {",
					"    pm.variables.set('token', response.data.token);",
					"    console.log('Token 已自动更新');",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "注册 - 正向",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('状态码 200', () => pm.response.to.have.status(200));",
									"const res = pm.response.json();",
									"pm.test('返回 code=200', () => pm.expect(res.code).to.eql(200));",
									"pm.test('返回用户名', () => pm.expect(res.data.username).to.be.a('string'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newuser_{{ $timestamp }}\",\n  \"password\": \"TestPass123\",\n  \"email\": \"newuser_{{ $timestamp }}@example.com\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "注册 - 重复用户名",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('状态码 200', () => pm.response.to.have.status(200));",
									"const res = pm.response.json();",
									"pm.test('返回错误码', () => pm.expect(res.code).to.not.eql(200));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"TestPass123\",\n  \"email\": \"dup@example.com\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "注册 - 密码过短",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('返回错误', () => pm.expect(res.code).to.eql(400));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"test_short_pass\",\n  \"password\": \"Ab1\",\n  \"email\": \"short@example.com\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "登录 - 正向",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('状态码 200', () => pm.response.to.have.status(200));",
									"const res = pm.response.json();",
									"pm.test('返回 code=200', () => pm.expect(res.code).to.eql(200));",
									"pm.test('返回 token', () => pm.expect(res.data.token).to.be.a('string'));",
									"pm.test('token 非空', () => pm.expect(res.data.token.length).to.be.above(0));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				},
				{
					"name": "登录 - 错误密码",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('返回错误', () => pm.expect(res.code).to.eql(401));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": "{{base_url}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"WrongPassword123\"\n}",
							"options": {"raw": {"language": "json"}}
						}
					}
				}
			]
		},
